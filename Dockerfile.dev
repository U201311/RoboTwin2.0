FROM data_generation_v2:v2 

# 确保以 root 用户运行
USER root

COPY . /workspace/robotwin_generation

# 强制重新设置所有权限
RUN chmod 755 /workspace/robotwin_generation/entrypoint.sh && \
    chmod 755 /workspace/robotwin_generation/collect_data.sh && \
    chmod -R 755 /workspace/robotwin_generation/

# 验证
RUN ls -la /workspace/robotwin_generation/entrypoint.sh

WORKDIR /workspace/robotwin_generation

# 使用 shell 格式作为备用方案
ENTRYPOINT ["/bin/bash", "/workspace/robotwin_generation/entrypoint.sh"]